# Hiddify-WhiteLabel - empty template. Copy to .env and chmod 600.
# Never commit the real .env file.

# Telegram token of the platform-owner MasterBot (from @BotFather).
MASTER_BOT_TOKEN=

# Telegram numeric user id of the platform owner. Only this id may use MasterBot.
MASTER_ADMIN_ID=

# Fernet key (urlsafe base64, 32 bytes) used to encrypt tenant bot tokens.
# Generate once with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store outside the database. Rotate via future documented procedure only.
TOKEN_ENCRYPTION_KEY=

# SQLite path for local dev/test. The current implementation is SQLite only;
# a PostgreSQL adapter and separate migration set are future work and must be
# written before any production deployment.
DATABASE_PATH=data/whitelabel.db

# Display timezone for human output. Storage is always UTC.
DISPLAY_TIMEZONE=Asia/Tehran

# Phase-3 license evaluator and durable notification worker.
LICENSE_JOB_INTERVAL_SECONDS=60
NOTIFICATION_LEASE_SECONDS=120
MAX_NOTIFICATION_RETRIES=5
NOTIFICATION_RETRY_BASE_SECONDS=30
RUNTIME_CACHE_TTL_SECONDS=15

# Phase-5 TenantRuntime sharding. Run one process per index 0..count-1.
# All processes share this source/database; no per-tenant process is created.
RUNTIME_SHARD_COUNT=4
RUNTIME_SHARD_INDEX=0
RUNTIME_RECONCILE_SECONDS=15
RUNTIME_START_CONCURRENCY=8
RUNTIME_POLL_TIMEOUT_SECONDS=20
# Subscription usage/expiry maintenance. Minimum 60 seconds.
RUNTIME_LIFECYCLE_SECONDS=180
# Shared managed subscription HTTP listener. Put a reverse proxy/TLS domain in
# front of this listener and set SMART_SUB_PUBLIC_BASE_URL to that public base.
SMART_SUB_HOST=127.0.0.1
SMART_SUB_PORT=8091
SMART_SUB_PUBLIC_BASE_URL=

